# Database
# 本地开发: DATABASE_URL="file:./dev.db"
# 生产: DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# NextAuth
AUTH_SECRET="change-me-to-a-random-string"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# 支付宝登录（可选，需要配 RSA2 密钥）
AUTH_ALIPAY_ID=""
AUTH_ALIPAY_PRIVATE_KEY=""
AUTH_ALIPAY_PUBLIC_KEY=""

# 微信登录（可选，需要微信开放平台 App）
AUTH_WECHAT_ID=""
AUTH_WECHAT_SECRET=""

# Email (for magic link login)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="noreply@example.com"

# AI API（支持任意 OpenAI 兼容接口）
# 不设置 KEY 时使用 mock 演示数据（本地测试无需配）
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""

# Creem（国内支付，支持信用卡/多种支付）
CREEM_API_KEY=""
# 通用产品 ID（旧）— 月付/年付不同时改用下面两个
# CREEM_PRODUCT_ID=""
CREEM_MONTHLY_PRODUCT_ID=""
CREEM_ANNUAL_PRODUCT_ID=""
CREEM_WEBHOOK_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Analytics
# Set to your domain to enable Plausible analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="cookmate.ai"

# 管理员页面（/admin 取消订阅审计台）访问白名单
# 填你自己的登录邮箱；只有用该邮箱登录才能看到 /admin 页面。留空则任何人无法访问（安全默认）。
ADMIN_EMAIL=""

# ─────────────────────────────────────────────────────────────
#  Vercel 部署必填环境变量清单（Vercel Dashboard → Settings → Environment Variables）
#  以下变量若未正确配置，对应功能会在生产环境静默失败或降级（fail-closed）
# ─────────────────────────────────────────────────────────────
# Creem（国内主支付，Dashboard 入口 → https://creem.io）
#   - CREEM_API_KEY                  Creem Dashboard → Settings → API keys
#   - CREEM_WEBHOOK_SECRET           Creem Dashboard → Webhooks → endpoint signing secret
#   - CREEM_MONTHLY_PRODUCT_ID       Creem Dashboard → Products → 产品 ID（月付）
#   - CREEM_ANNUAL_PRODUCT_ID        Creem Dashboard → Products → 产品 ID（年付）
# 支付宝（异步通知验签 + 一键登录）
#   - AUTH_ALIPAY_ID                 支付宝开放平台 → 应用 ID（app_id）
#   - AUTH_ALIPAY_PRIVATE_KEY        RSA2 私钥（应用公钥模式或老证书模式）
#   - AUTH_ALIPAY_PUBLIC_KEY         支付宝公钥（用于验签异步通知）
# 管理员鉴权
#   - ADMIN_EMAIL                    填可访问 /admin 审计台的登录邮箱
# Cron 定时任务
#   - CRON_SECRET                    Vercel Cron 调用 /api/cron/* 时的 Bearer token（必填，否则 401）
# 数据库
#   - DIRECT_URL                     Prisma migrate deploy 用的事务连接串（生产必填，本地 SQLite 可留空）

# E2E Testing
# 默认 http://localhost:3000，CI 中可设为 http://localhost:3001 避免端口冲突
# PLAYWRIGHT_BASE_URL="http://localhost:3001"